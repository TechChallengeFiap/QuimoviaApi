// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  PORT_OPERATOR
  SHIPPER_DRIVER
  TECHNICAL_MANAGER
  OPERATIONS_MANAGER
  SYSTEM_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model User {
  id           String     @id @default(uuid())
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(180)
  passwordHash String     @db.VarChar(255)
  role         UserRole
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum StatusShipment {
  ANALYZING
  INSPECTION
  APPROVED
  REPROVED
  BLOCKED
  RELEASED
}

model ChemicalShipment {
  id                String         @id @default(uuid())
  productId         String
  status            StatusShipment @default(ANALYZING)
  responsibleUserId String
  documentsIds      String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
}

enum ProductRiskClass {
  EXPLOSIVES
  GASES
  FLAMMABLE_LIQUIDS
  FLAMMABLE_SOLIDS
  OXIDIZING_SUBSTANCES
  TOXIC_SUBSTANCES
  RADIOACTIVE_MATERIALS
  CORROSIVE_SUBSTANCES
  MISCELLANEOUS_DANGEROUS_SUBSTANCES
}

enum ProductPhysicalState {
  SOLID
  LIQUID
  GASEOUS
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  UNDER_ANALYSIS
}

enum ProductDocumentType {
  SAFETY_DATA_SHEET
  CERTIFICATE
  ENVIRONMENTAL_LICENSE
  TECHNICAL_REPORT
  AUTHORIZATION
}

model ChemicalProduct {
  id            String               @id @default(uuid())
  code          String               @unique @db.VarChar(40)
  technicalName String               @db.VarChar(180)
  tradeName     String?              @db.VarChar(180)
  unNumber      String               @db.VarChar(4)
  riskClass     ProductRiskClass
  physicalState ProductPhysicalState
  status        ProductStatus        @default(UNDER_ANALYSIS)
  documents     ProductDocument[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model ProductDocument {
  id        String              @id @default(uuid())
  productId String
  product   ChemicalProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      ProductDocumentType
  number    String              @db.VarChar(80)
  expiresAt DateTime?
  filePath  String              @db.VarChar(500)
  createdAt DateTime            @default(now())

  @@index([productId])
}
