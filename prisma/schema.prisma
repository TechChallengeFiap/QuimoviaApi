// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Os valores e colunas mapeados mantêm os nomes já gravados no banco.
enum InspectionScope {
  SHIPMENT      @map("CARGO")
  SHIPMENT_ITEM @map("CARGO_ITEM")
}

enum InspectionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum InspectionRequirement {
  EXPIRATION_DATE
  PACKAGING_INTEGRITY
  NO_LEAKAGE
  CORRECT_LABELING
  TRANSPORT_CONDITIONS
  SAFETY_EQUIPMENT
}

enum InspectionItemResult {
  COMPLIANT
  NON_COMPLIANT
}

model Inspection {
  id                 String           @id @default(uuid())
  shipmentId         String           @map("cargoId")
  compositionVersion Int
  scope              InspectionScope
  shipmentItemId     String?          @map("cargoItemId")
  inspectorId        String
  status             InspectionStatus @default(PENDING)
  items              InspectionItem[]
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([shipmentId], map: "Inspection_cargoId_idx")
  @@index([inspectorId, status])
}

model InspectionItem {
  id           String                @id @default(uuid())
  inspectionId String
  inspection   Inspection            @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  requirement  InspectionRequirement
  result       InspectionItemResult?
  observation  String?               @db.VarChar(500)

  @@unique([inspectionId, requirement])
}

enum UserRole {
  PORT_OPERATOR
  SHIPPER_DRIVER
  TECHNICAL_MANAGER
  OPERATIONS_MANAGER
  SYSTEM_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model User {
  id                String             @id @default(uuid())
  name              String             @db.VarChar(120)
  email             String             @unique @db.VarChar(180)
  passwordHash      String             @db.VarChar(255)
  role              UserRole
  status            UserStatus         @default(ACTIVE)
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  chemicalShipments ChemicalShipment[]
  sessions          Session[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  endedAt   DateTime?

  @@index([userId, endedAt])
}

enum StatusShipment {
  ANALYZING
  INSPECTION
  APPROVED
  REPROVED
  BLOCKED
  RELEASED
}

model ChemicalShipment {
  id                String         @id @default(uuid())
  productId         String
  status            StatusShipment @default(ANALYZING)
  responsibleUserId String
  responsibleUser   User           @relation(fields: [responsibleUserId], references: [id])
  documentsIds      String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  @@index([responsibleUserId])
}
