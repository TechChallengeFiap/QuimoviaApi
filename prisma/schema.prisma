// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  PORT_OPERATOR
  SHIPPER_DRIVER
  TECHNICAL_MANAGER
  OPERATIONS_MANAGER
  SYSTEM_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model User {
  id           String     @id @default(uuid())
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(180)
  passwordHash String     @db.VarChar(255)
  role         UserRole
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum CargoDocumentStatus {
  PENDING
  UNDER_REVIEW
  COMPLIANT
  NON_COMPLIANT
}

enum DocumentType {
  SAFETY_DATA_SHEET
  CERTIFICATE
  LICENSE
  DECLARATION
  OTHER
}

model CargoDocument {
  id                 String                    @id @default(uuid())
  cargoId            String                    @unique
  shipperId          String
  compositionVersion Int
  status             CargoDocumentStatus       @default(PENDING)
  submittedAt        DateTime?
  revision           Int                       @default(0)
  attachments        CargoDocumentAttachment[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([shipperId, status])
}

model CargoDocumentAttachment {
  id                   String        @id @default(uuid())
  cargoDocumentId      String
  cargoDocument        CargoDocument @relation(fields: [cargoDocumentId], references: [id], onDelete: Cascade)
  name                 String        @db.VarChar(180)
  type                 DocumentType
  fileReference        String        @db.VarChar(1024)
  scopes               Json
  issuedAt             DateTime
  expiresAt            DateTime?
  replacesAttachmentId String?
  removedAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([cargoDocumentId])
}
