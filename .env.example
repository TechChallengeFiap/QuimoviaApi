MYSQL_ROOT_PASSWORD=senha_root
MYSQL_USER=seu_usuario
MYSQL_DATABASE=nome_do_banco
MYSQL_PASSWORD=sua_senha

DATABASE_URL=mysql://<MYSQL_USER>:<MYSQL_PASSWORD>@localhost:3333/<MYSQL_DATABASE>?allowPublicKeyRetrieval=true&useSSL=false

# Obrigatório, com ao menos 32 caracteres. Gere um, por exemplo: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
