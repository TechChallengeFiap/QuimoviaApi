MYSQL_ROOT_PASSWORD=senha_root
MYSQL_USER=seu_usuario
MYSQL_DATABASE=nome_do_banco
MYSQL_PASSWORD=sua_senha

DATABASE_URL=mysql://<MYSQL_USER>:<MYSQL_PASSWORD>@localhost:3333/<MYSQL_DATABASE>?allowPublicKeyRetrieval=true&useSSL=false

# Obrigatório, com ao menos 32 caracteres. Gere um, por exemplo: openssl rand -base64 48
JWT_SECRET=
# Duração do token em segundos: 31536000 = 1 ano, para o ambiente local e a avaliação. Em produção, use 3600 (1 hora).
JWT_EXPIRES_IN_SECONDS=31536000

ADMIN_NAME=Administrador do Sistema
ADMIN_EMAIL=admin@quimovia.com
# Senha do administrador inicial criado pelo seed, com ao menos 8 caracteres.
# Valor padrão para o ambiente local e a avaliação; troque em qualquer outro ambiente.
ADMIN_PASSWORD=Quimovia@2026
