{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug NestJS (tsx)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "--tsconfig", "tsconfig.json", "src/main.ts"],
      "console": "integratedTerminal",
      "restart": true,
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Attach to NestJS (Port 9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true
    }
  ]
}
